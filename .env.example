# .env.local 로 복사해서 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# Supabase 프로젝트 URL (Project Settings → API)
SUPABASE_URL=
# Supabase secret 키 (sb_secret_... 또는 service_role 키). 서버에서만 사용하며 절대 공개하지 마세요.
SUPABASE_SECRET_KEY=

# /dashboard 로그인 정보 (브라우저 기본 로그인 창). 비밀번호가 비어 있으면 대시보드가 열리지 않습니다.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
